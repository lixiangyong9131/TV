<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@id/exo_position"
        style="@style/ExoStyledControls.TimeText.Position"
        android:fontFeatureSettings="tnum"
        android:paddingHorizontal="0dp" />

    <androidx.media3.ui.DefaultTimeBar
        android:id="@id/exo_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        app:bar_height="5dp"
        app:buffered_color="#66FFFFFF"
        app:played_color="@color/player_red"
        app:scrubber_color="@color/player_red"
        app:scrubber_dragged_size="8dp"
        app:scrubber_enabled_size="5dp"
        app:touch_target_height="28dp"
        app:unplayed_color="#4AFFFFFF" />

    <TextView
        android:id="@id/exo_duration"
        style="@style/ExoStyledControls.TimeText.Position"
        android:fontFeatureSettings="tnum"
        android:paddingHorizontal="0dp" />

</LinearLayout>
