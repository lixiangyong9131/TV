<resources>

    <style name="Theme.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/netflix_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/netflix_red</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="colorSurface">@color/black</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/netflix_card</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorSecondaryContainer">@color/pill</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <item name="colorErrorContainer">@color/netflix_red</item>
        <item name="colorOnErrorContainer">@color/white</item>
        <item name="colorOutline">#4DFFFFFF</item>
        <item name="colorOutlineVariant">#333333</item>
        <item name="colorControlActivated">@color/netflix_red</item>
        <item name="bottomSheetDialogTheme">@style/NetflixSheet</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowAnimationStyle">@style/NetflixWindow</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="colorPrimaryContainer">@color/netflix_card</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
    </style>

    <style name="NetflixWindow" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/netflix_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/netflix_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/netflix_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/netflix_pop_exit</item>
    </style>

    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="android:windowBackground">@color/netflix_red</item>
        <item name="windowSplashScreenBackground">@color/netflix_red</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/netflix_red</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo_animated</item>
        <item name="windowSplashScreenAnimationDuration">1600</item>
    </style>

    <style name="Theme.App" parent="Theme.Base" />

    <style name="Theme.Crash" parent="Theme.Base">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@color/grey_700</item>
    </style>

    <style name="Control">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@color/yellow</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="ToolbarTextAppearance" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="titleTextColor">@color/ink</item>
    </style>

    <style name="NetflixSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/NetflixSheetStyle</item>
    </style>

    <style name="NetflixSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/netflix_card</item>
    </style>

    <style name="NetflixActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
    </style>

    <style name="MpvScriptItem">
        <item name="android:background">@drawable/shape_accent</item>
    </style>

</resources>
