<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 主内容区：左侧留出导航栏空间 -->
    <com.fongmi.android.tv.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="100dp">

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="28dp"
            android:paddingTop="88dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp"
            app:focusOutEnd="true"
            app:focusOutFront="true" />

    </com.fongmi.android.tv.ui.custom.ProgressLayout>

    <!-- ============ 顶部 Hero 横幅（独立布局，Netflix 风格）============ -->
    <FrameLayout
        android:id="@+id/heroBanner"
        android:layout_width="match_parent"
        android:layout_height="540dp"
        android:layout_marginStart="100dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/heroPic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_hero_overlay" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:layout_marginBottom="40dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/heroLogo"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_logo"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hero_series"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:maxLines="2"
                android:shadowColor="#C0000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:textColor="@color/white"
                android:textSize="46sp"
                android:textStyle="bold"
                tools:text="推荐影片" />

            <TextView
                android:id="@+id/heroDesc"
                android:layout_width="560dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:shadowColor="#C0000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:textColor="#E6E6E6"
                android:textSize="15sp"
                tools:text="精彩内容，立即播放" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/heroPlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_button"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="30dp"
                    android:paddingTop="11dp"
                    android:paddingEnd="30dp"
                    android:paddingBottom="11dp"
                    android:text="@string/hero_play"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 顶部信息条（站点名/时钟），叠在 hero 上方 -->
    <FrameLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="100dp">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingTop="18dp"
            android:paddingEnd="28dp"
            android:paddingBottom="8dp">

            <com.fongmi.android.tv.ui.custom.CustomTitleView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:focusable="false"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="20sp"
                tools:text="09:20:00" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>

    <!-- ============ 左侧竖排图标导航（Netflix TV 风格）============ -->
    <LinearLayout
        android:id="@+id/sideNav"
        android:layout_width="100dp"
        android:layout_height="match_parent"
        android:layout_gravity="start|center_vertical"
        android:background="@drawable/bg_side_nav"
        android:gravity="center_horizontal|center_vertical"
        android:orientation="vertical"
        android:paddingTop="72dp"
        android:paddingBottom="24dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navHome"
            android:layout_width="@dimen/nav_item_size"
            android:layout_height="@dimen/nav_item_size"
            android:layout_marginBottom="@dimen/nav_item_gap"
            android:background="@drawable/selector_item"
            android:contentDescription="@string/home_vod"
            android:focusable="true"
            android:padding="15dp"
            android:src="@drawable/nf_ic_home"
            android:tint="@color/selector_func" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navLive"
            android:layout_width="@dimen/nav_item_size"
            android:layout_height="@dimen/nav_item_size"
            android:layout_marginBottom="@dimen/nav_item_gap"
            android:background="@drawable/selector_item"
            android:contentDescription="@string/home_live"
            android:focusable="true"
            android:padding="15dp"
            android:src="@drawable/nf_ic_video"
            android:tint="@color/selector_func" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navSearch"
            android:layout_width="@dimen/nav_item_size"
            android:layout_height="@dimen/nav_item_size"
            android:layout_marginBottom="@dimen/nav_item_gap"
            android:background="@drawable/selector_item"
            android:contentDescription="@string/home_search"
            android:focusable="true"
            android:padding="15dp"
            android:src="@drawable/nf_ic_search"
            android:tint="@color/selector_func" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navKeep"
            android:layout_width="@dimen/nav_item_size"
            android:layout_height="@dimen/nav_item_size"
            android:layout_marginBottom="@dimen/nav_item_gap"
            android:background="@drawable/selector_item"
            android:contentDescription="@string/home_keep"
            android:focusable="true"
            android:padding="15dp"
            android:src="@drawable/nf_ic_bookmark"
            android:tint="@color/selector_func" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navPush"
            android:layout_width="@dimen/nav_item_size"
            android:layout_height="@dimen/nav_item_size"
            android:layout_marginBottom="@dimen/nav_item_gap"
            android:background="@drawable/selector_item"
            android:contentDescription="@string/home_push"
            android:focusable="true"
            android:padding="15dp"
            android:src="@drawable/nf_ic_gamepad"
            android:tint="@color/selector_func" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navSetting"
            android:layout_width="@dimen/nav_item_size"
            android:layout_height="@dimen/nav_item_size"
            android:background="@drawable/selector_item"
            android:contentDescription="@string/home_setting"
            android:focusable="true"
            android:padding="15dp"
            android:src="@drawable/nf_ic_settings"
            android:tint="@color/selector_func" />

    </LinearLayout>

</FrameLayout>
