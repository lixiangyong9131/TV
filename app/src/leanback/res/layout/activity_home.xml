<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingStart="48dp"
    android:paddingTop="28dp"
    android:paddingEnd="48dp"
    android:paddingBottom="24dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/nav"
        android:layout_width="210dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="20dp"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/logo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_tv_mark" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/navSearch"
            style="@style/HomeNavItem"
            android:orientation="horizontal"
            android:nextFocusRight="@id/recycler">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home_search" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/HomeNavLabel"
                android:text="@string/home_search" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/navHistory"
            style="@style/HomeNavItem"
            android:orientation="horizontal"
            android:nextFocusRight="@id/recycler">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_setting_history" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/HomeNavLabel"
                android:text="@string/home_history" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/navKeep"
            style="@style/HomeNavItem"
            android:orientation="horizontal"
            android:nextFocusRight="@id/recycler">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home_keep" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/HomeNavLabel"
                android:text="@string/home_keep" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/navLive"
            style="@style/HomeNavItem"
            android:orientation="horizontal"
            android:nextFocusRight="@id/recycler"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home_live" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/HomeNavLabel"
                android:text="@string/home_live" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/navVod"
            style="@style/HomeNavItem"
            android:orientation="horizontal"
            android:nextFocusRight="@id/recycler">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home_vod" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/HomeNavLabel"
                android:text="@string/home_vod" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/navPush"
            style="@style/HomeNavItem"
            android:orientation="horizontal"
            android:nextFocusRight="@id/recycler">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home_connect" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/HomeNavLabel"
                android:text="@string/home_push" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/navSetting"
            style="@style/HomeNavItem"
            android:orientation="horizontal"
            android:nextFocusRight="@id/recycler">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home_setting" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/HomeNavLabel"
                android:text="@string/home_setting" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <com.fongmi.android.tv.ui.custom.CustomTitleView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:background="@drawable/selector_item"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/homeSearch"
                android:nextFocusDown="@id/heroPlay"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="28sp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/homeSearch"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/selector_item"
                android:contentDescription="@string/home_search"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/title"
                android:nextFocusRight="@id/homeHistory"
                android:padding="14dp"
                android:src="@drawable/ic_home_search" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/homeHistory"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/selector_item"
                android:contentDescription="@string/home_history"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/homeSearch"
                android:nextFocusRight="@id/historyEdit"
                android:padding="14dp"
                android:src="@drawable/ic_setting_history" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/historyEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/selector_item"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/homeHistory"
                android:text="@string/history_delete"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="24sp"
                tools:text="09:20:00" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <FrameLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/heroImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_hero_scrim" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/heroName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        tools:text="Title" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/heroRemark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/white_80"
                        android:textSize="16sp"
                        tools:text="Remark" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/heroPlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/selector_item"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/navVod"
                    android:nextFocusUp="@id/title"
                    android:nextFocusDown="@id/recycler"
                    android:text="@string/play"
                    android:textColor="@color/white"
                    android:textSize="20sp" />
            </androidx.appcompat.widget.LinearLayoutCompat>
        </FrameLayout>

        <com.fongmi.android.tv.ui.custom.ProgressLayout
            android:id="@+id/progressLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.leanback.widget.VerticalGridView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="16dp"
                app:focusOutEnd="true"
                app:focusOutFront="true" />
        </com.fongmi.android.tv.ui.custom.ProgressLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
