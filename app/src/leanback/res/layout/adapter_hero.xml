<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/heroRoot"
    android:layout_width="1100dp"
    android:layout_height="300dp"
    android:background="@color/black"
    android:focusable="true">

    <!-- 剧照背景 -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/heroPic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription" />

    <!-- 左侧渐黑遮罩 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_overlay" />

    <!-- 文字信息 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="28dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/heroLogo"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_logo"
                tools:ignore="ContentDescription" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hero_series"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:maxLines="2"
            android:shadowColor="#B0000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:textColor="@color/white"
            android:textSize="38sp"
            android:textStyle="bold"
            tools:text="推荐影片" />

        <TextView
            android:id="@+id/heroDesc"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#B0000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:textColor="#E6E6E6"
            android:textSize="14sp"
            tools:text="精彩内容，立即播放" />

        <TextView
            android:id="@+id/heroPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_button"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="26dp"
            android:paddingTop="9dp"
            android:paddingEnd="26dp"
            android:paddingBottom="9dp"
            android:text="@string/hero_play"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
