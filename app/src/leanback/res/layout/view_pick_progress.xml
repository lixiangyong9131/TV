<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pickRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0141218"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="28dp"
    android:paddingEnd="48dp"
    android:paddingBottom="24dp"
    android:tag="ProgressLayout.TAG_PROGRESS">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/pickTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pick_title"
        android:textColor="@color/white"
        android:textSize="28sp"
        tools:text="Title" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/pickMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/white_80"
        android:textSize="18sp"
        android:visibility="gone"
        tools:text="Highest score first" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/pickCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/white"
        android:textSize="18sp"
        tools:text="Checking 1/4" />

    <FrameLayout
        android:id="@+id/pickTrack"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:background="@color/white_20">

        <View
            android:id="@+id/pickBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:scaleX="0.04"
            android:transformPivotX="0dp" />
    </FrameLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/pickBest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/selector_item"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/pickList"
        android:text="@string/pick_play_best"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pickList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        android:overScrollMode="never"
        android:visibility="gone"
        tools:listitem="@layout/adapter_quality_rank"
        tools:visibility="visible" />

    <View
        android:id="@+id/pickBones"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/pickDone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</androidx.appcompat.widget.LinearLayoutCompat>
